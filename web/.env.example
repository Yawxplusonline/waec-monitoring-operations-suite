# ============================================================================
# WAEC SENTINEL — ENVIRONMENT CONFIGURATION ($0 COST ARCHITECTURE)
# ============================================================================
# Leave Firebase fields blank to run in instant Local Real-Time Sync Mode
# (uses BroadcastChannel + IndexedDB/localStorage across browser tabs/windows).
# Populate these values to connect directly to Firebase Spark Free Tier RTDB.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=https://waec-sentinel-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=waec-sentinel
VITE_FIREBASE_STORAGE_BUCKET=waec-sentinel.appspot.com
VITE_FIREBASE_APP_ID=

# Optional: Telegram Bot API for Instant Emergency SOS Mobile Dispatch ($0 Cost)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Google Maps API Key for High-Resolution Real-Time Satellite Monitoring & Geocoding
VITE_GOOGLE_MAPS_API_KEY=
